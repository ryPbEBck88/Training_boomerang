# Shared reverse proxy: trainers + transfer on one PC (ports 80/443).
# SITE_ADDRESS     -> Django trainers (service web:8000)
# TRANSFER_ADDRESS -> transfer site (TRANSFER_UPSTREAM), optional

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip
	reverse_proxy web:8000
	header {
		-Server
	}
}

{$TRANSFER_ADDRESS} {
	encode gzip
	reverse_proxy {$TRANSFER_UPSTREAM}
	header {
		-Server
	}
}
