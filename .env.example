# Скопируйте в .env и поправьте под себя:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

DEBUG=0

# Секрет Django (сгенерируйте свой длинный ключ)
# SECRET_KEY=change-me-to-a-long-random-string

# Домены, которые принимает Django (через запятую, без пробелов)
# Основной: i-croupier.ru
# Если используете CrazyDNS / QuietHouse DDNS — добавьте полное имя сюда же
ALLOWED_HOSTS=i-croupier.ru,www.i-croupier.ru,localhost,127.0.0.1

# CSRF для HTTPS-форм (через запятую)
CSRF_TRUSTED_ORIGINS=https://i-croupier.ru,https://www.i-croupier.ru

# Caddy: имена для сертификата Let's Encrypt (через запятую, без пробелов)
SITE_ADDRESS=i-croupier.ru,www.i-croupier.ru
ACME_EMAIL=you@example.com

# Опционально: алерт в Telegram, если сайт упал
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
