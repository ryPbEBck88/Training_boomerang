DEBUG=0

# Trainers public host
ALLOWED_HOSTS=i-croupier.quiethouse.crazedns.ru,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://i-croupier.quiethouse.crazedns.ru
SITE_ADDRESS=i-croupier.quiethouse.crazedns.ru
ACME_EMAIL=you@example.com

# Transfer site (same Caddy, different hostname). Example:
# TRANSFER_ADDRESS=transfer.quiethouse.crazedns.ru
# TRANSFER_UPSTREAM=host.docker.internal:8080
# If transfer already runs in Docker on port 8080 without binding 80/443, leave as below.
# Put the REAL transfer hostname you use in QuietHouse:
TRANSFER_ADDRESS=transfer.quiethouse.crazedns.ru
TRANSFER_UPSTREAM=host.docker.internal:8080

# Optional Telegram monitor
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
